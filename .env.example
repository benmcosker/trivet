# --- Database -------------------------------------------------------------
# Local dev: a Postgres instance you control.
# Production: Neon's POOLED connection string - serverless functions open more
# connections than Postgres accepts directly.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/mealmagic"

# Migrations only, and only in production. Neon's pooled endpoint runs PgBouncer
# in transaction mode, which cannot hold the session locks Prisma Migrate needs,
# so `prisma migrate deploy` gets Neon's DIRECT string instead. Leave unset
# locally: it falls back to DATABASE_URL.
DIRECT_DATABASE_URL=""

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Recipe extraction ----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Cards one person may have read per day. Reading a card is the only thing
# here that costs money every time, and the upload endpoint is reachable by
# anyone with an account. Optional: unset means 30, which is far above what
# anybody adding recipes for a household will ever hit.
UPLOAD_DAILY_LIMIT=""

# --- Instacart ------------------------------------------------------------
# Leave unset. Instacart is not accepting new developer applications and has no
# waitlist, so no key can be obtained. The provider stays built and tested but
# is hidden from the planner until a key exists, at which point it reappears on
# its own. Amazon Fresh and Whole Foods need no key at all.
INSTACART_API_KEY=""
INSTACART_API_BASE="https://connect.dev.instacart.tools"

# --- File storage ---------------------------------------------------------
# Unset locally: uploads fall back to ./public/uploads on disk (gitignored).
# On Vercel this is injected automatically when a Blob store is attached.
BLOB_READ_WRITE_TOKEN=""

# --- Texting the shopping list --------------------------------------------
# Unset: the button is hidden and nothing is sent. The list can still be
# copied as text, which is what it fell back to before this existed.
#
# US numbers additionally need A2P 10DLC registration on the Twilio side
# (a brand and a campaign, low-volume tier is enough for a household).
# Without it carriers do not reject the messages, they silently drop them -
# so the app reports success and nothing arrives.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Development only, and refused outright when NODE_ENV=production: makes the
# feature reachable with no Twilio account by writing messages to the server
# log instead of sending them. Without this the whole flow is untestable
# locally, because the button only appears when something can actually send.
SMS_LOG_ONLY=""

# --- Password resets -------------------------------------------------------
# Unset: /forgot-password says so plainly instead of taking an address and
# sending nothing. That is deliberate - the reset endpoint answers the same way
# for a real address and a made-up one, on purpose, so it has no way to tell
# somebody "there is no mail provider" rather than "check your inbox". Silence
# would leave a locked-out person waiting on a mail that was never coming.
#
# EMAIL_FROM must be an address at a domain verified with the provider
# (trivetbox.com here). An unverified sender is accepted by the API and then
# not delivered.
RESEND_API_KEY=""
EMAIL_FROM=""

# Development only, and refused outright when NODE_ENV=production: makes the
# reset flow reachable with no mail account by writing the message - link and
# all - to the server log. Same shape and same reasoning as SMS_LOG_ONLY.
EMAIL_LOG_ONLY=""

# Who can see /admin - the activity overview: which households exist, how much
# each is using the planner, and how many cards they have uploaded. Counts and
# dates only; it shows nothing anybody cooked, planned or shopped for.
#
# Comma-separated, case-insensitive. Left empty, /admin answers 404 for
# everybody, which is also what it answers for anyone not on this list - a 403
# would tell a stranger the page exists.
#
# An environment variable rather than a column on the user, so nobody can grant
# themselves the role through the app and revoking it is a deploy.
#
# In a hosting dashboard paste the bare address, with no quotes around it -
# the quotes below belong to the .env file format, not to the value. They are
# stripped if they come along anyway, because a value that arrives as
# "ben@example.com" with the marks attached matches nobody and 404s exactly
# like a stranger would see.
ADMIN_EMAILS=""
